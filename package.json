
{
  "name": "project-flame",
  "version": "1.0.2",
  "description": "Project Flame Game Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "Project Flame",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.projectflame.launcher",
    "productName": "Project Flame",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Flame"
    },
    "publish": {
      "provider": "github",
      "owner": "itsreallauris-dot",
      "repo": "project-flame-launcher"
    }
  }
}
